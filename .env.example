# --- Database (SQLite file; swap the provider in prisma/schema.prisma for Postgres later)
DATABASE_URL="file:../data/chattering.db"

# --- Encryption keys. Comma-separated `version:base64(32 bytes)` pairs.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotate by adding a new version, setting it active, and running `npm run rotate-keys`.
APP_ENCRYPTION_KEYS="v1:REPLACE_WITH_BASE64_32_BYTES"
APP_ENCRYPTION_ACTIVE_KEY="v1"

# --- Session cookie signing secret (any long random string)
SESSION_SECRET="REPLACE_WITH_LONG_RANDOM_STRING"

# --- Encrypted media storage directory
MEDIA_DIR="./data/media"

# --- AI providers (adapters in src/lib/ai). `mock` works offline with no keys.
AI_TEXT_PROVIDER="mock"            # mock | openai-compatible | anthropic
AI_TEXT_MODEL="mock-roleplay-1"
AI_TEXT_API_KEY=""
AI_TEXT_BASE_URL="https://api.openai.com/v1"

AI_IMAGE_PROVIDER="mock"           # mock | openai-compatible
AI_IMAGE_MODEL="mock-diffusion-1"
AI_IMAGE_API_KEY=""
AI_IMAGE_BASE_URL="https://api.openai.com/v1"

# --- Rate limiting (requests per window; see src/lib/rate-limit.ts)
RATE_LIMIT_TRUST_PROXY="false"

# --- Set to "true" to allow sign-ups (default true)
ALLOW_SIGNUPS="true"
